#include <Adafruit_NeoPixel.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <DFRobotDFPlayerMini.h>

// --- Pin Definitions for Seeduino XIAO ---
#define LED_PIN       8  // Moved from 6 to 8 to avoid DFPlayer TX conflict
#define MODE_BUTTON   2
#define RELOAD_BUTTON 3
#define DISPLAY_TOGGLE_BUTTON 10  // Moved from 4 to avoid I2C SDA conflict
#define TRIGGER_BUTTON 1

// DFPlayer Mini wiring for Seeduino XIAO:
// DFPlayer TX → XIAO D7 (RX1)
// DFPlayer RX → XIAO D6 (TX1) (Use a voltage divider if DFPlayer is 5V)
// OLED uses I2C: SDA = D4, SCL = D5 — DO NOT share these pins with DFPlayer

#define NUM_LEDS      15
#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 32
#define OLED_RESET    -1

Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);
DFRobotDFPlayerMini dfplayer;

enum Mode { STUN, STING, BLAST };
Mode currentMode = BLAST;

int shotsRemaining = 100;
unsigned long energy = 935135246;
bool showBarGraph = true;

unsigned long lastModePress = 0;
unsigned long lastReloadPress = 0;
unsigned long lastTogglePress = 0;
unsigned long lastTriggerPress = 0;

void setup() {
  pinMode(MODE_BUTTON, INPUT_PULLUP);
  pinMode(RELOAD_BUTTON, INPUT_PULLUP);
  pinMode(DISPLAY_TOGGLE_BUTTON, INPUT_PULLUP);
  pinMode(TRIGGER_BUTTON, INPUT_PULLUP);

  strip.begin();
  strip.show();

  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.setRotation(1); // Portrait mode
  display.clearDisplay();
  display.display();

  Serial.begin(115200);
  while (!Serial && millis() < 2000);

  Serial1.begin(9600);
  if (!dfplayer.begin(Serial1)) {
    display.setCursor(0, 0);
    display.print("DFPlayer FAIL");
    display.display();
    while (true);
  }
  dfplayer.volume(25);

  showBootAnimation();
  updateDisplay();
}

void loop() {
  if (digitalRead(MODE_BUTTON) == LOW && millis() - lastModePress > 300) {
    currentMode = static_cast<Mode>((currentMode + 1) % 3);
    lastModePress = millis();
    updateDisplay();
  }

  if (digitalRead(RELOAD_BUTTON) == LOW && millis() - lastReloadPress > 300) {
    shotsRemaining = 100;
    energy = 935135246;
    dfplayer.playMp3Folder(4);
    lastReloadPress = millis();
    updateDisplay();
  }

  if (digitalRead(DISPLAY_TOGGLE_BUTTON) == LOW && millis() - lastTogglePress > 300) {
    showBarGraph = !showBarGraph;
    lastTogglePress = millis();
    updateDisplay();
  }

  if (digitalRead(TRIGGER_BUTTON) == LOW && millis() - lastTriggerPress > 300) {
    lastTriggerPress = millis();
    fireBlaster();
  }
}

void colorWipe(uint32_t color, int wait) {
  for (int i = 0; i < NUM_LEDS; i++) {
    strip.setPixelColor(i, color);
    strip.show();
    delay(wait);
  }
  strip.clear();
  strip.show();
}

void fireBlaster() {
  if (shotsRemaining <= 0) {
    dfplayer.playMp3Folder(5);
    return;
  }

  switch (currentMode) {
    case STUN:
      dfplayer.playMp3Folder(1);
      colorWipe(strip.Color(0, 0, 255), 30);
      break;
    case STING:
      dfplayer.playMp3Folder(2);
      colorWipe(strip.Color(255, 50, 0), 10);
      break;
    case BLAST:
      dfplayer.playMp3Folder(3);
      colorWipe(strip.Color(150, 0, 0), 10);
      break;
  }

  shotsRemaining--;
  energy = map(shotsRemaining, 0, 100, 0, 935135246);

  updateDisplay();
}

void updateDisplay() {
  display.clearDisplay();

  if (showBarGraph) {
    const int segmentCount = 15;
    const int segmentHeight = (SCREEN_HEIGHT - 10) / segmentCount;
    int segmentsToDraw = map(shotsRemaining, 0, 100, 0, segmentCount);

    for (int i = 0; i < segmentsToDraw; i++) {
      int y = SCREEN_HEIGHT - 10 - (i + 1) * segmentHeight;
      display.fillRect(SCREEN_WIDTH / 2 - 4, y, 8, segmentHeight - 1, WHITE);
      display.display();
      delay(20); // blink animation
    }

    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor((SCREEN_WIDTH - 36) / 2, SCREEN_HEIGHT - 8);
    switch (currentMode) {
      case STUN: display.print("STUN"); break;
      case STING: display.print("STING"); break;
      case BLAST: display.print("LETHAL"); break;
    }
  } else {
    display.setTextSize(2);
    display.setTextColor(WHITE);

    char buffer[12];
    sprintf(buffer, "%09lu", energy);

    for (int i = 0; i < 9; i++) {
      display.setCursor(i * 14, 0);
      display.write(buffer[i]);
    }

    display.setTextSize(1);
    display.setTextColor(WHITE);
    display.setCursor((SCREEN_WIDTH - 36) / 2, SCREEN_HEIGHT - 8);
    switch (currentMode) {
      case STUN: display.print("STUN"); break;
      case STING: display.print("STING"); break;
      case BLAST: display.print("LETHAL"); break;
    }
  }

  display.display();
}

const unsigned char empire_logo [] PROGMEM = {
  0x00, 0x7E, 0xFF, 0x81, 0xA5, 0x81, 0xBD, 0x81,
  0xBD, 0x81, 0xA5, 0x81, 0xFF, 0x7E, 0x00, 0x00,
};

void showBootAnimation() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);

  display.setCursor(0, 0);
  display.println("Connecting to HUD...");
  display.display();
  delay(1000);

  float voltage = analogRead(A0) * (3.3 / 1023.0) * 2.0;
  display.setCursor(0, 10);
  display.print("Powercell V: ");
  display.println(voltage, 2);
  display.display();
  delay(1000);

  display.clearDisplay();
  display.drawBitmap((SCREEN_WIDTH - 32) / 2, 0, empire_logo, 32, 32, WHITE);
  display.display();
  dfplayer.playMp3Folder(6);
  delay(2500);
  display.clearDisplay();
}
